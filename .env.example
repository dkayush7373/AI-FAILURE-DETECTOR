# AI Failure Detector Configuration

# Application Environment
ENVIRONMENT=production
APP_NAME="AI Failure Detector API"
APP_VERSION="1.0.0"

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./ai_failure_detector.db

# Interactive Simulation / Demo Mode (true/false)
# When set to true, simulates multi-step agent execution, tool failures, and deterministically injects realistic failure modes across the 25 test cases.
DEMO_MODE=true

# Optional: Live LLM / Agent Endpoint Configuration
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
